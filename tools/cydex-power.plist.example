<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apaga e acende o CYD junto com o Mac. Compile o vigia, troque /CAMINHO/DO/cydex
  pelo caminho do repositório, copie para
  ~/Library/LaunchAgents/local.cydex.power.plist e rode:
    swiftc -O tools/cydex_power_watch.swift -o tools/cydex-power-watch
    launchctl load ~/Library/LaunchAgents/local.cydex.power.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.cydex.power</string>
  <key>ProgramArguments</key>
  <array>
    <string>/CAMINHO/DO/cydex/tools/cydex-power-watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/cydex-power.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cydex-power.log</string>
</dict>
</plist>
