{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Janela principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
